{
  "name": "Behind",
  "image": "mcr.microsoft.com/dotnet/sdk:11.0",
  "mounts": [
    "source=${localEnv:XDG_RUNTIME_DIR}/podman/podman.sock,target=/run/podman/podman.sock,type=bind"
  ],
  "initializeCommand": ["bash", "${localWorkspaceFolder}/.devcontainer/docker-host.sh", "${localWorkspaceFolder}/.devcontainer/docker-host.env"],
  "runArgs": ["--env-file", "${localWorkspaceFolder}/.devcontainer/docker-host.env"],
  "customizations": {
    "zed": {
      "extensions": [
        "csharp"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.vscode-dotnet-runtime",
        "Continue.continue",
        "ryanluker.vscode-coverage-gutters",
        "formulahendry.dotnet-test-explorer"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "updateContentCommand": "apt-get update && apt-get install -y ffmpeg podman",
  "postCreateCommand": "dotnet --info && dotnet new list && ffmpeg -version",
  "remoteEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "1",
    "CONTAINER_HOST": "unix:///run/podman/podman.sock",
    "DOCKER_HOST": "${containerEnv:DOCKER_HOST}",
    "TESTCONTAINERS_RYUK_DISABLED": "${localEnv:TESTCONTAINERS_RYUK_DISABLED:true}",
    "TESTCONTAINERS_HOST_OVERRIDE": "${localEnv:TESTCONTAINERS_HOST_OVERRIDE:host.containers.internal}"
  }
}

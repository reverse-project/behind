{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reverse-project/behind/schemas/licenses-1.0.0.schema.json",
  "title": "Behind bundled licenses 1.0.0",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["name", "version", "license", "copyright", "url", "scope", "text"],
    "properties": {
      "name": { "$ref": "#/$defs/nonBlankString" },
      "version": { "$ref": "#/$defs/nonBlankString" },
      "license": { "$ref": "#/$defs/nonBlankString" },
      "copyright": { "$ref": "#/$defs/nonBlankString" },
      "url": { "$ref": "#/$defs/nonBlankString" },
      "scope": { "enum": ["frontend", "server", "development"] },
      "text": { "$ref": "#/$defs/nonBlankString" },
      "note": { "type": ["string", "null"] }
    },
    "additionalProperties": true
  },
  "$defs": {
    "nonBlankString": { "type": "string", "pattern": "\\S" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Behind MCP JSON-RPC 1.1.0",
  "description": "JSON-RPC messages for the stateless MCP endpoint. tools/list may include operation schemas generated from the currently enabled modules.",
  "oneOf": [
    { "$ref": "#/$defs/Request" },
    { "$ref": "#/$defs/Notification" },
    { "$ref": "#/$defs/Response" },
    { "$ref": "#/$defs/ErrorResponse" }
  ],
  "$defs": {
    "Request": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": ["string", "number"] },
        "method": { "type": "string" },
        "params": { "type": "object" }
      },
      "required": ["jsonrpc", "id", "method"],
      "additionalProperties": false
    },
    "Notification": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "type": "string", "pattern": "^notifications/" },
        "params": { "type": "object" }
      },
      "required": ["jsonrpc", "method"],
      "not": { "required": ["id"] },
      "additionalProperties": false
    },
    "Response": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": ["string", "number"] },
        "result": {
          "type": "object",
          "properties": {
            "protocolVersion": { "type": "string" },
            "serverInfo": { "type": "object" },
            "capabilities": { "type": "object" },
            "instructions": { "type": "string" },
            "tools": { "type": "array", "items": { "$ref": "#/$defs/Tool" } },
            "content": { "type": "array", "items": { "$ref": "#/$defs/ToolContent" } },
            "isError": { "type": "boolean" },
            "structuredContent": { "type": "object" }
          },
          "additionalProperties": true
        }
      },
      "required": ["jsonrpc", "id", "result"],
      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": ["string", "number", "null"] },
        "error": { "$ref": "#/$defs/Error" }
      },
      "required": ["jsonrpc", "id", "error"],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": { "type": "integer" },
        "message": { "type": "string" },
        "data": {}
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "Tool": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "inputSchema": { "$ref": "#/$defs/InputSchema" },
        "annotations": { "type": "object" }
      },
      "required": ["name", "inputSchema"],
      "additionalProperties": true
    },
    "InputSchema": {
      "type": "object",
      "properties": {
        "type": { "const": "object" },
        "properties": {
          "type": "object",
          "additionalProperties": { "type": ["object", "boolean"] }
        },
        "required": { "type": "array", "items": { "type": "string" } },
        "additionalProperties": { "type": ["object", "boolean"] }
      },
      "required": ["type", "properties"]
    },
    "ToolContent": {
      "type": "object",
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" }
      },
      "required": ["type", "text"],
      "additionalProperties": true
    },
    "ToolCallResult": {
      "type": "object",
      "properties": {
        "content": { "type": "array", "items": { "$ref": "#/$defs/ToolContent" } },
        "isError": { "type": "boolean" },
        "structuredContent": { "type": "object" }
      },
      "required": ["content"],
      "additionalProperties": true
    },
    "ToolsListResult": {
      "type": "object",
      "properties": {
        "tools": { "type": "array", "items": { "$ref": "#/$defs/Tool" } }
      },
      "required": ["tools"],
      "additionalProperties": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:behind:oidc-sign-in:1.0.0",
  "title": "Behind OIDC sign-in handoff 1.0.0",
  "oneOf": [
    { "$ref": "#/$defs/providers" },
    { "$ref": "#/$defs/redeemRequest" }
  ],
  "$defs": {
    "provider": {
      "type": "object",
      "required": ["id", "displayName"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "displayName": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "array",
      "items": { "$ref": "#/$defs/provider" }
    },
    "redeemRequest": {
      "type": "object",
      "required": ["ticket"],
      "properties": { "ticket": { "type": "string", "minLength": 1 } }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:behind:oidc-sign-in:2.0.0",
  "title": "Behind OIDC sign-in and provider settings 2.0.0",
  "oneOf": [
    { "$ref": "#/$defs/providers" },
    { "$ref": "#/$defs/redeemRequest" },
    { "$ref": "#/$defs/settings" }
  ],
  "$defs": {
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "displayName"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "displayName": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "redeemRequest": {
      "type": "object",
      "required": ["ticket"],
      "properties": { "ticket": { "type": "string", "minLength": 1 } }
    },
    "providerSettings": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "displayName": { "type": "string" },
        "enabled": { "type": "boolean", "default": true },
        "authority": { "type": "string" },
        "clientId": { "type": "string" },
        "clientSecret": { "type": "string", "default": "" },
        "hasClientSecret": { "type": "boolean", "default": false },
        "clearClientSecret": { "type": "boolean", "default": false },
        "scopes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "autoCreateUsers": { "type": "boolean", "default": true },
        "linkByVerifiedEmail": { "type": "boolean", "default": false },
        "roleClaimType": { "type": "string" },
        "roleMappings": {
          "type": "object",
          "propertyNames": { "minLength": 1 },
          "additionalProperties": {
            "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
          }
        },
        "autoCreateRoles": { "type": "boolean", "default": false },
        "autoCreateRolePrefix": { "type": ["string", "null"] }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "ticketLifetime": { "type": "string", "default": "00:02:00" },
        "authenticationTimeout": { "type": "string", "default": "00:10:00" },
        "maxPendingTickets": { "type": "integer", "minimum": 1, "default": 1000 },
        "providers": { "type": "array", "items": { "$ref": "#/$defs/providerSettings" } }
      },
      "not": { "required": ["ticket"] }
    }
  }
}

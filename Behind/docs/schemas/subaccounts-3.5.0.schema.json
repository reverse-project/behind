{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subaccounts-3.5.0.schema.json",
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "email": {
      "type": [
        "string",
        "null"
      ],
      "format": "email",
      "maxLength": 255
    },
    "birthday": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "pin": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]*$"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "create": {
      "type": "object",
      "properties": {
        "displayName": {
          "$ref": "#/$defs/name"
        },
        "birthday": {
          "$ref": "#/$defs/birthday"
        },
        "isChild": {
          "type": "boolean"
        },
        "email": {
          "$ref": "#/$defs/email"
        },
        "pin": {
          "$ref": "#/$defs/pin"
        },
        "primaryPin": {
          "$ref": "#/$defs/pin"
        },
        "proof": {
          "anyOf": [
            {
              "$ref": "#/$defs/proof"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "displayName"
      ],
      "if": {
        "anyOf": [
          {
            "required": [
              "pin"
            ],
            "properties": {
              "pin": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "primaryPin"
            ],
            "properties": {
              "primaryPin": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "proof"
        ],
        "properties": {
          "proof": {
            "$ref": "#/$defs/proof",
            "properties": {
              "primaryPin": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    "update": {
      "type": "object",
      "properties": {
        "displayName": {
          "$ref": "#/$defs/name"
        },
        "birthday": {
          "$ref": "#/$defs/birthday"
        },
        "isChild": {
          "type": "boolean"
        },
        "pin": {
          "$ref": "#/$defs/pin"
        },
        "clearPin": {
          "type": "boolean"
        },
        "proof": {
          "anyOf": [
            {
              "$ref": "#/$defs/proof"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "displayName"
      ],
      "not": {
        "required": [
          "clearPin",
          "pin"
        ],
        "properties": {
          "clearPin": {
            "const": true
          },
          "pin": {
            "type": "string"
          }
        }
      },
      "if": {
        "anyOf": [
          {
            "required": [
              "pin"
            ],
            "properties": {
              "pin": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "clearPin"
            ],
            "properties": {
              "clearPin": {
                "const": true
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "proof"
        ],
        "properties": {
          "proof": {
            "$ref": "#/$defs/proof"
          }
        }
      }
    },
    "switch": {
      "type": "object",
      "properties": {
        "pin": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "account": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "birthday": {
          "$ref": "#/$defs/birthday"
        },
        "isChild": {
          "type": "boolean"
        },
        "email": {
          "$ref": "#/$defs/email"
        },
        "userId": {
          "$ref": "#/$defs/id"
        },
        "hasPin": {
          "type": "boolean"
        },
        "canRelease": {
          "type": "boolean"
        }
      },
      "required": [
        "displayName",
        "isChild",
        "userId",
        "hasPin",
        "canRelease"
      ]
    },
    "switchAccount": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "birthday": {
          "type": "null"
        },
        "isChild": {
          "type": "boolean"
        },
        "email": {
          "type": "null"
        },
        "userId": {
          "$ref": "#/$defs/id"
        },
        "hasPin": {
          "type": "boolean"
        }
      },
      "required": [
        "displayName",
        "isChild",
        "userId",
        "hasPin"
      ]
    },
    "created": {
      "type": "object",
      "properties": {
        "userId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "userId"
      ]
    },
    "family": {
      "type": "object",
      "properties": {
        "isPrimary": {
          "type": "boolean"
        },
        "primaryUserId": {
          "$ref": "#/$defs/id"
        },
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/account"
          }
        },
        "primaryHasPin": {
          "type": "boolean"
        },
        "canBrowseAndRelease": {
          "type": "boolean",
          "description": "Whether the current session can browse candidates and release eligible children or primary-owned profiles."
        },
        "linkUnlinkEnabled": {
          "type": "boolean",
          "description": "Whether the current session can use invitation actions."
        },
        "linkUnlinkRequiresDirectSignIn": {
          "type": "boolean",
          "description": "Whether linking is configured and the current primary account needs a direct sign-in to use invitation actions."
        },
        "currentHasPin": {
          "type": "boolean",
          "description": "Whether the signed-in account has a switching PIN."
        },
        "isLinked": {
          "type": "boolean"
        },
        "canRespondToInvitations": {
          "type": "boolean"
        },
        "switchAccounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/switchAccount"
          }
        },
        "canManageChildren": {
          "type": "boolean",
          "description": "Whether this session may manage children in its authorized family."
        }
      },
      "required": [
        "accounts",
        "isPrimary",
        "primaryUserId",
        "primaryHasPin",
        "canBrowseAndRelease",
        "linkUnlinkEnabled",
        "linkUnlinkRequiresDirectSignIn",
        "currentHasPin",
        "isLinked",
        "canRespondToInvitations",
        "switchAccounts",
        "canManageChildren"
      ]
    },
    "candidate": {
      "type": "object",
      "properties": {
        "userId": {
          "$ref": "#/$defs/id"
        },
        "displayName": {
          "type": "string"
        }
      },
      "required": [
        "userId",
        "displayName"
      ]
    },
    "candidateList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "invitation": {
      "type": "object",
      "properties": {
        "requestId": {
          "$ref": "#/$defs/id"
        },
        "userId": {
          "$ref": "#/$defs/id"
        },
        "displayName": {
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "userId",
        "displayName"
      ]
    },
    "invitationList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/invitation"
      }
    },
    "proof": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "currentPin"
          ],
          "properties": {
            "currentPin": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "required": [
            "primaryPin"
          ],
          "properties": {
            "primaryPin": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "required": [
            "password"
          ],
          "properties": {
            "password": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "required": [
            "magicToken"
          ],
          "properties": {
            "magicToken": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ],
      "properties": {
        "currentPin": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "primaryPin": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "The signed-in primary user's current switching PIN. Valid only when setting, changing or removing a linked subaccount's switching PIN."
        },
        "password": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "magicToken": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "pinMutation": {
      "type": "object",
      "properties": {
        "pin": {
          "$ref": "#/$defs/pin"
        },
        "clearPin": {
          "type": "boolean"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      },
      "required": [
        "proof"
      ],
      "oneOf": [
        {
          "required": [
            "pin"
          ],
          "properties": {
            "pin": {
              "type": "string",
              "minLength": 1
            },
            "clearPin": {
              "const": false
            }
          }
        },
        {
          "required": [
            "clearPin"
          ],
          "properties": {
            "clearPin": {
              "const": true
            },
            "pin": {
              "type": "null"
            }
          }
        }
      ]
    },
    "pinProofRequest": {
      "type": "object",
      "required": [
        "operation"
      ],
      "properties": {
        "operation": {
          "enum": [
            "change",
            "remove",
            "create"
          ]
        }
      }
    },
    "selfPinMutation": {
      "type": "object",
      "description": "A linked subaccount setting, changing or removing its own switching PIN.",
      "oneOf": [
        {
          "description": "Setup is allowed only while the signed-in linked subaccount has no PIN.",
          "required": [
            "pin"
          ],
          "properties": {
            "pin": {
              "$ref": "#/$defs/pin",
              "type": "string",
              "minLength": 1
            },
            "clearPin": {
              "const": false
            },
            "proof": {
              "type": "null"
            }
          }
        },
        {
          "$ref": "#/$defs/pinMutation",
          "properties": {
            "proof": {
              "required": [
                "currentPin"
              ],
              "properties": {
                "currentPin": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "description": "A switched adult without a PIN may set its first PIN using password or email proof.",
          "$ref": "#/$defs/pinMutation",
          "required": ["pin"],
          "properties": {
            "pin": {
              "type": "string",
              "minLength": 1
            },
            "clearPin": {
              "const": false
            },
            "proof": {
              "oneOf": [
                { "required": ["password"], "properties": { "password": { "type": "string", "minLength": 1 } } },
                { "required": ["magicToken"], "properties": { "magicToken": { "type": "string", "minLength": 1 } } }
              ]
            }
          }
        }
      ]
    }
  }
}

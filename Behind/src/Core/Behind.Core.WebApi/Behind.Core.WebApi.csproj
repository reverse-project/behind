<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Common\Behind.Common.WebApi\Behind.Common.WebApi.csproj" />
      <ProjectReference Include="..\Behind.Core.Common\Behind.Core.Common.csproj" />
      <ProjectReference Include="..\Behind.Core.Database.Postgres\Behind.Core.Database.Postgres.csproj" />
      <ProjectReference Include="..\Behind.Core.Database.Sqlite\Behind.Core.Database.Sqlite.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Fido2" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Scalar.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="security.json" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Frontend\**\*" />
        <EmbeddedResource Include="..\..\..\..\LICENSE" Link="Frontend\licenses\Behind.txt" />
    </ItemGroup>

</Project>

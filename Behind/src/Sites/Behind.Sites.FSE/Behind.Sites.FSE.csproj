<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup>
      <ContainerBaseImage>mcr.microsoft.com/dotnet/runtime-deps:11.0-resolute</ContainerBaseImage>
      <PublishSingleFile>true</PublishSingleFile>
      <SelfContained>true</SelfContained>
      <ContainerRepository>reverse-project/behind/sites/fse</ContainerRepository>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Core\Behind.Core.WebApi\Behind.Core.WebApi.csproj" />
      <ProjectReference Include="..\..\Sport\Behind.Sport.WebApi\Behind.Sport.WebApi.csproj" />
      <ProjectReference Include="..\Behind.Sites.FSE.Database.Postgres\Behind.Sites.FSE.Database.Postgres.csproj" />
      <ProjectReference Include="..\Behind.Sites.FSE.Database.Sqlite\Behind.Sites.FSE.Database.Sqlite.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Update="database.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Content Update="backend.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Content Update="email.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Content Update="security.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>

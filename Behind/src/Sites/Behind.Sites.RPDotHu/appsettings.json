{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "OpenTelemetry": {
    "ServiceName": "rpdothu-localhost-dev",
    "IsEnabled": true,
    "Traces": {
      "IsEnabled": true,
      "Endpoint": "https://monitoring.prod.zwebnt.hu/otlp/v1/traces",
      "Protocol": "HttpProtobuf",
      "Instruments": [
        "AspNetCoreInstrumentation",
        "HttpClientInstrumentation",
        "OtlpExporter"
      ]
    },
    "Metrics": {
      "IsEnabled": true,
      "Endpoint": "https://monitoring.prod.zwebnt.hu/otlp/v1/metrics",
      "Protocol": "HttpProtobuf",
      "Instruments": [
        "AspNetCoreInstrumentation",
        "HttpClientInstrumentation",
        "RuntimeInstrumentation",
        "OtlpExporter"
      ]
    },
    "Logging": {
      "IsEnabled": true,
      "Endpoint": "https://monitoring.prod.zwebnt.hu/otlp/v1/logs",
      "Protocol": "HttpProtobuf",
      "Instruments": [
        "OtlpExporter"
      ],
      "IncludeFormattedMessage": true,
      "IncludeScopes": true,
      "ParseStateValues": true
    }
  },
  "AllowedHosts": "*"
}

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
      <ContainerBaseImage>mcr.microsoft.com/dotnet/runtime-deps:11.0-resolute</ContainerBaseImage>
      <PublishSingleFile>true</PublishSingleFile>
      <SelfContained>true</SelfContained>
      <ContainerRepository>reverse-project/behind/web-database-migrator</ContainerRepository>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="../../Contact/Behind.Contact.WebApi/Behind.Contact.WebApi.csproj" />
      <ProjectReference Include="../../Contact/Behind.Contact.Database.Sqlite/Behind.Contact.Database.Sqlite.csproj" />
      <ProjectReference Include="../../Contact/Behind.Contact.Database.Postgres/Behind.Contact.Database.Postgres.csproj" />
      <ProjectReference Include="../../Forum/Behind.Forum.WebApi/Behind.Forum.WebApi.csproj" />
      <ProjectReference Include="../../Forum/Behind.Forum.Database.Sqlite/Behind.Forum.Database.Sqlite.csproj" />
      <ProjectReference Include="../../Forum/Behind.Forum.Database.Postgres/Behind.Forum.Database.Postgres.csproj" />
      <ProjectReference Include="..\..\Core\Behind.Core.Database.Migrator\Behind.Core.Database.Migrator.csproj" />
      <ProjectReference Include="..\..\MarkdownViewer\Behind.MarkdownViewer.WebApi\Behind.MarkdownViewer.WebApi.csproj" />
      <ProjectReference Include="..\..\Quotes\Behind.Quotes.Database.Postgres\Behind.Quotes.Database.Postgres.csproj" />
      <ProjectReference Include="..\..\Quotes\Behind.Quotes.Database.Sqlite\Behind.Quotes.Database.Sqlite.csproj" />
      <ProjectReference Include="..\..\Quotes\Behind.Quotes.WebApi\Behind.Quotes.WebApi.csproj" />
      <ProjectReference Include="..\..\Sport\Behind.Sport.Database.Postgres\Behind.Sport.Database.Postgres.csproj" />
      <ProjectReference Include="..\..\Sport\Behind.Sport.Database.Sqlite\Behind.Sport.Database.Sqlite.csproj" />
      <ProjectReference Include="..\..\Sport\Behind.Sport.WebApi\Behind.Sport.WebApi.csproj" />
      <ProjectReference Include="..\Behind.Web.Database.Postgres\Behind.Web.Database.Postgres.csproj" />
      <ProjectReference Include="..\Behind.Web.Database.Sqlite\Behind.Web.Database.Sqlite.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Extensions.Hosting" />
    </ItemGroup>

    <ItemGroup>
      <Content Update="database.json">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
      <Content Update="backend.json">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
      <None Remove="database.json" />
      <None Remove="backend.json" />
      <Content Include="backend.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="database.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <!-- The referenced Core migrator flows its own backend.json/database.json into publish output and collides with ours. -->
    <Target Name="ExcludeCoreMigratorConfigFromPublish" AfterTargets="GetCopyToPublishDirectoryItems">
      <PropertyGroup>
        <CoreMigratorDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\Core\Behind.Core.Database.Migrator\'))</CoreMigratorDir>
      </PropertyGroup>
      <ItemGroup>
        <_SourceItemsToCopyToPublishDirectory Remove="$(CoreMigratorDir)backend.json;$(CoreMigratorDir)database.json" />
        <_SourceItemsToCopyToPublishDirectoryAlways Remove="$(CoreMigratorDir)backend.json;$(CoreMigratorDir)database.json" />
        <_SourceItemsToCopyToPublishDirectoryIfDifferent Remove="$(CoreMigratorDir)backend.json;$(CoreMigratorDir)database.json" />
      </ItemGroup>
    </Target>

</Project>